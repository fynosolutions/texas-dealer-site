---
import Journey from './Journey.astro';
import PurchasingTerms from './PurchasingTerms.astro';
import { tr, company, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh-Hant';
const prefix = isZh ? '/zh-Hant' : '';
const telHref = `tel:${company.phone.replace(/[^0-9+]/g, '')}`;


const offers = [
  { key: 'o1', img: '/assets/soup-dumplings-steamer.png' },
  { key: 'o2', img: '/assets/five-color-gyoza-black-platter.png' },
  { key: 'o3', img: '/assets/texas-delivery.png' },
];


---


<section class="bg-white text-brand-ink">
  <div class="container-x pt-10 sm:pt-14 pb-12 sm:pb-16">
    <div>
      <span class="title-mark" aria-hidden="true"></span>
      <h1 class="display-hx text-bal text-[clamp(34px,3.8vw,56px)]">{tr('wholesale.hero.title', locale)}</h1>
    </div>
    <p class="page-lede lede-indent mt-5 text-bal">
      {tr('wholesale.hero.body', locale)}
    </p>
  </div>
</section>


<section class="bg-white text-brand-ink">
  <div class="container-x pb-16 sm:pb-20">
    <div class="mb-10 sm:mb-12">
      <div>
      <span class="title-mark" aria-hidden="true"></span>
        <h2 class="display-hx text-bal text-[clamp(28px,2.9vw,42px)]">{tr('wholesale.offers.title', locale)}</h2>
      </div>
      <p class="lede-indent mt-3 text-[16px] leading-[1.6] text-brand-ink/65">
        {tr('wholesale.offers.sub', locale).split(' · ').map((g, i) => <>{i > 0 && <span class="hidden sm:inline"> · </span>}<span class="block sm:inline whitespace-nowrap">{g}</span></>)}
      </p>
    </div>

    
    <div class="space-y-5 sm:space-y-6">
      {offers.map((o, i) => (
        <div class="border border-black/10 bg-white overflow-hidden" data-offer={o.key}>
          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch lg:h-[440px]">
            <div class:list={['lg:col-span-5 p-7 sm:p-12 flex flex-col justify-center order-2', i % 2 ? 'lg:order-2' : 'lg:order-1']}>
              <h3 class="display-hx text-bal text-[24px] sm:text-[30px] leading-[1.2] mb-4">{tr(`wholesale.offers.${o.key}.title`, locale)}</h3>
              {tr(`wholesale.offers.${o.key}.stat`, locale) && <div class="display-hx text-[38px] sm:text-[50px] leading-none text-brand-red mb-4">
                {tr(`wholesale.offers.${o.key}.stat`, locale)}
              </div>}
              <p class="text-[17px] sm:text-[18px] leading-[1.7] text-brand-ink/75 max-w-[40ch]">{tr(`wholesale.offers.${o.key}.body`, locale)}</p>
            </div>
            <div class:list={['lg:col-span-7 order-1', i % 2 ? 'lg:order-1' : 'lg:order-2']}>
              <img
                src={o.img}
                alt={tr(`wholesale.offers.${o.key}.title`, locale)}
                class:list={["w-full h-[240px] sm:h-[340px] lg:h-full object-cover", o.key === 'o1' && "object-[50%_35%]"]}
                width={o.key !== 'o1' ? 1536 : undefined}
                height={o.key !== 'o1' ? 1024 : undefined}
                loading="lazy"
              />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4">
      <a href={`${prefix}/contact/`} class="inline-flex items-center justify-center rounded-full bg-brand-red text-white px-8 py-3.5 text-[15px] font-medium hover:bg-brand-red-dark transition-colors">
        {tr('nav.requestSamples', locale)} →
      </a>
      <a href={company.phone ? telHref : undefined} aria-disabled={!company.phone || undefined} class="inline-flex items-center justify-center rounded-full border border-black/30 text-brand-ink px-8 py-3.5 text-[15px] hover:bg-black hover:text-white transition-colors">
        ☎ {company.phone || (isZh ? "[電話待補]" : "[Phone to be added]")}
      </a>
    </div>
  </div>
</section>


<PurchasingTerms locale={locale} />

<Journey locale={locale} />
