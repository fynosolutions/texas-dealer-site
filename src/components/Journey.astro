---
import { tr, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-Hant';
const prefix = zh ? '/zh-Hant' : '';
const steps = zh
  ? ['聯絡銷售', '免費試樣', '獲取報價', '確認訂單', '每週配送', '後續補貨']
  : ['Contact sales', 'Free samples', 'Receive a quote', 'Confirm your order', 'Weekly delivery', 'Plan your next order'];
---
<section class="bg-[#F7F0E1] text-brand-ink" data-journey>
  <div class="container-x py-16 sm:py-24">
    <span class="title-mark mx-auto" aria-hidden="true"></span>
    <h2 class="display-hx text-[34px] sm:text-[52px] text-center">{zh ? '合作流程' : 'How We Work Together'}</h2>
    <ol class="partnership-steps mt-10 sm:mt-14">
      {steps.map((step, i) => <li>
        <img class="step-art" src={`/assets/journey/step-${i + 1}.png`} alt="" width="160" height="160" loading="lazy" decoding="async" />
        <div class="step-copy">
          <span class="step-number">0{i + 1}</span>
          <span class="step-title">{step}</span>
        </div>
      </li>)}
    </ol>
    <p class="mt-8 text-center text-[14px] leading-relaxed text-brand-ink/70 max-w-3xl mx-auto">
      {zh ? '試樣品種與數量由銷售確認。' : 'Sales will confirm which samples and quantities we can send.'}
    </p>
    <div class="mt-8 flex justify-center">
      <a href={`${prefix}/contact/`} class="btn-primary rounded-full">{tr('journey.cta', locale)} →</a>
    </div>
  </div>
</section>
<style>
  .partnership-steps { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px; }
  .partnership-steps li { min-width: 0; text-align: center; }
  .step-art { display: block; width: 100%; max-width: 148px; height: auto; aspect-ratio: 1; margin: 0 auto 20px; }
  .step-number { display: block; color: #b91c1c; font-size: 15px; font-weight: 600; letter-spacing: 0.08em; margin-bottom: 6px; }
  .step-title { display: block; font-size: 17px; line-height: 1.5; font-weight: 500; }
  .step-optional { display: block; font-size: 13px; line-height: 1.5; margin-top: 6px; color: #665b49; }
  @media (max-width: 1023px) { .partnership-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; } }
  @media (max-width: 639px) {
    .partnership-steps { grid-template-columns: 1fr; gap: 20px; }
    .partnership-steps li { display: flex; align-items: center; gap: 20px; text-align: left; }
    .step-art { width: 88px; flex: 0 0 88px; margin: 0; }
    .step-copy { min-width: 0; }
    .step-number { margin-bottom: 3px; font-size: 15px; }
    .step-title { font-size: 18px; }
  }
</style>
