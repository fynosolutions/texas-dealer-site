---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';
interface Props { locale: Locale; title: string; currentPath: string; }
const {locale, title, currentPath} = Astro.props;
const SITE = 'https://yayadumplings.com';
const basePath = currentPath.replace(/^\/zh-Han[st]\//, '/');
const canonical = SITE + currentPath;
const isHome = /^\/(zh-Han[st]\/)?$/.test(currentPath);
const description = locale !== 'en' ? '為德州餐飲店提供水餃、煎餃、包點及點心選品、批發報價與配送溝通。' : 'Dumplings, gyoza, buns and dim sum for Texas restaurants. Product selection, wholesale pricing and delivery coordination.';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={SITE + basePath} />
    <link rel="alternate" hreflang="zh-Hant" href={SITE + '/zh-Hant' + basePath} />
    <link rel="alternate" hreflang="zh-Hans" href={SITE + '/zh-Hans' + basePath} />
    <link rel="alternate" hreflang="x-default" href={SITE + basePath} />
    <script is:inline>
      if (location.hostname === 'yayadumplings.com') {
        var gs = document.createElement('script'); gs.async = true;
        gs.src = 'https://www.googletagmanager.com/gtag/js?id=G-KL5JWRGZ0Y';
        document.head.appendChild(gs);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date()); gtag('config', 'G-KL5JWRGZ0Y', { anonymize_ip: true });
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="tel:"],a[href^="mailto:"]');
          if (!a) return;
          var tel = a.getAttribute('href').indexOf('tel:') === 0;
          var inFooter = !!a.closest('footer'), inHeader = !!a.closest('header');
          gtag('event', tel ? 'call_click' : 'email_click', { click_location: inHeader ? 'header' : inFooter ? 'footer' : 'page', page_path: location.pathname });
        });
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/assets/yaya-logo.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE + '/assets/gyoza-chopsticks-dark.jpg'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class={`bg-white text-brand-ink antialiased ${locale === 'zh-Hans' ? 'font-sans-sc' : locale === 'zh-Hant' ? 'font-sans-cn' : 'font-sans'}`}>
    <Header locale={locale} currentPath={currentPath} />
    <main class={isHome ? '' : 'pt-24 sm:pt-28'}><slot /></main>
    <Footer locale={locale} hideForm={currentPath.includes('/contact')} />
    <script>import '../scripts/interactions';</script>
  </body>
</html>
